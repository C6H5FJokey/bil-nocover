{
  "manifest_version": 3,
  "name": "Bili NoCover · 免疫推荐",
  "version": "0.2.0",
  "description": "提前隐藏哔哩哔哩推荐、热搜和评论，清除推荐占位词，并按核心词筛选搜索结果，支持展开恢复。",
  "action": {
    "default_title": "Bili NoCover · 当前屏蔽范围",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["*://search.bilibili.com/*", "*://api.bilibili.com/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "css": ["common.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://t.bilibili.com/*"],
      "css": ["dynamic.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://search.bilibili.com/*"],
      "css": ["search.css"],
      "js": ["search-filter.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://search.bilibili.com/*"],
      "js": ["search-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
